# Vorlage für config.yaml. Kopieren und anpassen:
#
#   cp config.yaml.example config.yaml
#
# config.yaml selbst ist nicht versioniert — dort stehen die echten Jäger mit
# Adresse und Telefonnummer. Diese Datei enthält nur Platzhalter.

hunters:
- name: Max Mustermann
  address: Musterweg 1, 12345 Musterstadt
  phone: 0123 456789
  email: max@example.com

# Wildarten mit ihren eigenen Teilstücken und Vorgaben. Beim Drucken stehen nur
# die Teilstücke der gewählten Wildart zur Auswahl; derselbe Name kann je Wildart
# einen anderen Preis haben.
#
# Pro Teilstück (alles optional, leer = {}):
#   price:       Preis pro kg — oder Festpreis, wenn beim Erfassen "5x" steht
#   weight_kg:   Standardgewicht, wird im Formular vorbelegt
#   kind:        cut (Teilstück, Standard) oder prep (Zubereitung)
#   ingredients: Zutaten, klein unten auf dem Info-Etikett
#   recipe:      Name eines Rezepts dieser Wildart — ersetzt "ingredients"
#
# Vorgaben für den Sammeldruck belegen die Zeilen vor und dürfen nur
# Teilstücke derselben Wildart verwenden.
species:
- name: Reh
  parts:
    Keule:
      price: 16.0
    Rücken:
      price: 22.0
    Schulter/Blatt:
      price: 12.0
    Filet:
      price: 28.0
    Hals/Träger:
      price: 9.0
    Gulasch:
      price: 11.0
    Hackfleisch:
      price: 9.5
  presets:
  - name: Reh komplett
    items:
    - part: Keule
      count: 2
    - part: Schulter/Blatt
      count: 2
    - part: Rücken
      count: 1
    - part: Filet
      count: 1
    - part: Hackfleisch
      count: 6
- name: Wildschwein
  parts:
    Keule:
      price: 14.0
    Rücken:
      price: 20.0
    Bauch:
      price: 9.0
    Gulasch:
      price: 11.0
    Hackfleisch:
      price: 9.5
    Bratwurst:
      kind: prep
      recipe: Salsiccia
  presets: []
  # Rezepte gehören zur Wildart. Eine Zubereitung mit "recipe:" bekommt die
  # Zutaten fürs Etikett aus dem Rezept, nach Gewicht sortiert.
  recipes:
  - name: Salsiccia
    items:
    - name: Wildschweinfleisch
      amount: 5.0
      unit: kg
    - name: Schweinespeck
      amount: 1.0
      unit: kg
    - name: Speisesalz
      amount: 120.0
      unit: g
    - name: Fenchel
      amount: 30.0
      unit: g
    - name: Naturdarm (Schwein)
      amount: 3.0
      unit: m
    notes: Fleisch mit 4-mm-Scheibe wolfen, Gewürze untermengen, in Naturdarm füllen.
- name: Fasan
  parts:
    Brust: {}
    Keule: {}
  presets: []

# backend: pyusb | linux_kernel | network | agent   (siehe README)
# identifier: usb://0x04f9:0x209b  ist die QL-800-Kennung, auf jedem Gerät gleich
printers:
- name: Mac
  model: QL-800
  label: 39x90
  backend: pyusb
  identifier: usb://0x04f9:0x209b
default_printer: Mac

# Haltbarkeit auf dem Etikett, in Monaten.
best_before_months: 12

# true = nur registrieren, nicht drucken. Zum Ausprobieren zunächst true lassen.
dry_run: true

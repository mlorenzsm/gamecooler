# Template for config.yaml. Copy and adjust:
#
#   cp config.yaml.example config.yaml
#
# config.yaml itself is not under version control — it holds the real hunters
# with address and phone number. This file contains only placeholders.

hunters:
- name: Max Mustermann
  address: Musterweg 1, 12345 Musterstadt
  phone: 0123 456789
  email: max@example.com

# Species, each with its own cuts and presets. When printing, only the cuts of
# the selected species are offered; the same name can have a different price
# per species.
#
# Per cut (all optional, empty = {}):
#   price:       price per kg — or a fixed price if "5x" is entered
#   weight_kg:   default weight, pre-filled in the form
#   kind:        cut (cut, default) or prep (preparation)
#   ingredients: ingredients, in small print at the bottom of the info label
#   recipe:      name of a recipe of this species — replaces "ingredients"
#
# Presets for bulk print pre-fill the rows and may only use cuts of the same
# species.
species:
- name: Reh
  parts:
    Keule:
      price: 16.0
    Rücken:
      price: 22.0
    Schulter/Blatt:
      price: 12.0
    Filet:
      price: 28.0
    Hals/Träger:
      price: 9.0
    Gulasch:
      price: 11.0
    Hackfleisch:
      price: 9.5
  presets:
  - name: Reh komplett
    items:
    - part: Keule
      count: 2
    - part: Schulter/Blatt
      count: 2
    - part: Rücken
      count: 1
    - part: Filet
      count: 1
    - part: Hackfleisch
      count: 6
- name: Wildschwein
  parts:
    Keule:
      price: 14.0
    Rücken:
      price: 20.0
    Bauch:
      price: 9.0
    Gulasch:
      price: 11.0
    Hackfleisch:
      price: 9.5
    Bratwurst:
      kind: prep
      recipe: Salsiccia
  presets: []
  # Recipes belong to the species. A preparation with "recipe:" gets the
  # ingredients for its label from the recipe, sorted by weight.
  recipes:
  - name: Salsiccia
    items:
    - name: Wildschweinfleisch
      amount: 5.0
      unit: kg
    - name: Schweinespeck
      amount: 1.0
      unit: kg
    - name: Speisesalz
      amount: 120.0
      unit: g
    - name: Fenchel
      amount: 30.0
      unit: g
    - name: Naturdarm (Schwein)
      amount: 3.0
      unit: m
    notes: Fleisch mit 4-mm-Scheibe wolfen, Gewürze untermengen, in Naturdarm füllen.
- name: Fasan
  parts:
    Brust: {}
    Keule: {}
  presets: []

# backend: pyusb | linux_kernel | network | agent   (see README)
# identifier: usb://0x04f9:0x209b  is the QL-800 ID, the same on every device
printers:
- name: Mac
  model: QL-800
  label: 39x90
  backend: pyusb
  identifier: usb://0x04f9:0x209b
default_printer: Mac

# Shelf life printed on the label, in months.
best_before_months: 12

# true = only record, don't print. Leave it at true while trying things out.
dry_run: true

# Language of the printed labels and the invoice: de or en. Independent of
# the web UI language, which each browser picks for itself.
label_language: de

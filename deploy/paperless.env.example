# Paperless-ngx upload for gamecooler. Copy to /etc/gamecooler/paperless.env
# (mode 0640, root:gamecooler) and fill in — see docs/paperless.md.
#
# The token is a secret: keep the real value in the password manager, never
# in the repo, config.yaml, a ticket or a chat.

# Base URL of Paperless, without a trailing slash and without /api
PAPERLESS_URL=https://paperless.home.arpa

# API token of the Paperless user "gamecooler" (Profile -> API Auth Token)
PAPERLESS_TOKEN=

# Caddy as TLS terminator in front of the app.
#
# Important: HTTPS is not cosmetic here. The scan page uses the phone camera
# via getUserMedia, and browsers only allow that in a "secure context"
# (HTTPS or localhost). Over plain HTTP the scanner silently fails to start —
# see app/templates/scan.html.
#
# The hostname must be resolvable on the phone. IP addresses don't work,
# because a TLS certificate is issued for a name (see docs/deploy.md,
# section "Hostname").
#
# To adjust: the name must be identical in Pi-hole (Local DNS), here, and in
# the browser. home.arpa is the namespace RFC 8375 designates for home
# networks — not .local (mDNS, Android doesn't resolve it) and not .lan.
#
# __HOST__ is a placeholder that is replaced during deploy with the name of
# this environment (deploy/autodeploy.sh, apply_caddy). That way the same file
# works in both environments without the name being fixed here.
#
#   Test: gamecooler-test.home.arpa
#   Prod: wildbret.home.arpa
#
# The name comes from /etc/default/gamecooler-autodeploy (GAMECOOLER_HOST).
#
# Deliberately NO Caddy {$VAR:default}: the Debian package doesn't read
# /etc/default/caddy — the unit has no EnvironmentFile, and --environ only
# prints the environment. {$GAMECOOLER_HOST:default} therefore always silently
# falls back to the default. That is exactly how the test container listened
# under the prod name for a while: reachable, but under the wrong name, and the
# health check (which only checks 127.0.0.1:8010) doesn't notice.
#
# A placeholder can't fail that way: if GAMECOOLER_HOST is missing, the deploy
# aborts instead of installing a wrong name.

__HOST__ {
	# Without this line Caddy tries ACME (Let's Encrypt / ZeroSSL) and
	# fails: Let's Encrypt rejects .arpa with "rejectedIdentifier ...
	# forbidden by policy", ZeroSSL requires EAB credentials. Caddy only uses
	# the internal CA automatically for names without a dot, for "localhost",
	# or with an explicit tls internal — home.arpa falls into none of these
	# cases. The handshake then aborts with "tlsv1 alert internal error",
	# because there is no certificate.
	tls internal

	encode zstd gzip

	reverse_proxy 127.0.0.1:8010 {
		# The app doesn't care which name it is reached under.
		header_up Host {host}
	}

	# Separate log files per environment, derived from the same name — so
	# there is only one switch per environment instead of two. A hostname is a
	# valid file name, so the result is wildbret.home.arpa.log or
	# gamecooler-test.home.arpa.log.
	log {
		output file /var/log/caddy/__HOST__.log
	}
}

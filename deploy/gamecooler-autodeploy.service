[Unit]
Description=Gamecooler Autodeploy (fetches the latest state of the configured branch)
Documentation=file:/opt/gamecooler/docs/autodeploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# The wrapper, NOT /opt/gamecooler/deploy/autodeploy.sh directly: the script
# overwrites itself during deploy, and bash reads scripts by file offset — a
# change mid-run can tear the execution apart. The wrapper copies it to /run
# first. See the comment at the top of the script.
ExecStart=/usr/local/bin/gamecooler-autodeploy

# The deploy needs root: git checkout in /opt, uv sync, files to /etc,
# systemctl. Hence no User= and no sandbox here — the isolation lives in
# gamecooler.service, which locks down the app itself.
#
# Some headroom, because uv sync can take a while depending on network latency.
TimeoutStartSec=300

# No Restart=: this is a timer job, not a long-running service. A failure is
# retried on the next timer run anyway (or the commit is then marked as bad
# and skipped).

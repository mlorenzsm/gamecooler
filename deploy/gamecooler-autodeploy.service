[Unit]
Description=Gamecooler Autodeploy (holt den neuesten Stand des konfigurierten Branches)
Documentation=file:/opt/gamecooler/docs/autodeploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Der Wrapper, NICHT /opt/gamecooler/deploy/autodeploy.sh direkt: das Skript
# überschreibt sich beim Deploy selbst, und bash liest Skripte über
# Datei-Offsets — eine Änderung mitten im Lauf kann die Ausführung zerreissen.
# Der Wrapper kopiert es vorher nach /run. Siehe Kommentar im Skriptkopf.
ExecStart=/usr/local/bin/gamecooler-autodeploy

# Der Deploy braucht root: git checkout in /opt, uv sync, Dateien nach /etc,
# systemctl. Deshalb kein User= und keine Sandbox hier — die Isolation sitzt
# im gamecooler.service, der die App selbst einsperrt.
#
# Etwas Luft nach oben, weil uv sync je nach Netzlaufzeit dauern kann.
TimeoutStartSec=300

# Kein Restart=: das ist ein Timer-Job, kein Dauerdienst. Ein Fehlschlag wird
# beim nächsten Timer-Lauf ohnehin erneut versucht (bzw. der Commit ist dann
# als fehlerhaft markiert und wird übersprungen).

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Print agent as a LaunchAgent on the Mac the QL-800 is connected to.

  __REPO__ and __LOGDIR__ are placeholders: launchd understands neither ~ nor
  environment variables in paths, so all paths must be absolute. For
  installation see README, section "Print agent".

  The .venv directly instead of "uv run" — same reason as in gamecooler.service:
  starting doesn't need uv, and launchd has a minimal PATH that lacks
  /opt/homebrew/bin.

  A LaunchAgent only runs while the user is logged in. After a reboot it
  starts only once the user logs in.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.gamecooler.agent</string>

	<key>ProgramArguments</key>
	<array>
		<string>__REPO__/.venv/bin/uvicorn</string>
		<string>agent.main:app</string>
		<string>--host</string>
		<string>0.0.0.0</string>
		<string>--port</string>
		<string>8020</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__REPO__</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>AGENT_PRINTER_IDENTIFIER</key>
		<string>usb://0x04f9:0x209b</string>
		<key>AGENT_PRINTER_BACKEND</key>
		<string>pyusb</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<!-- Restart after a crash. ThrottleInterval keeps an agent that dies
	     immediately again (port in use, broken .venv) from keeping launchd
	     busy every second. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>__LOGDIR__/gamecooler-agent.log</string>
	<key>StandardErrorPath</key>
	<string>__LOGDIR__/gamecooler-agent.log</string>
</dict>
</plist>

[Unit]
Description=Gamecooler Webapp
Documentation=file:/opt/gamecooler/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=gamecooler
Group=gamecooler
WorkingDirectory=/opt/gamecooler

# Straight into the .venv, NOT via "uv run": uv creates its cache under
# $HOME/.cache/uv, and ProtectHome=yes makes $HOME inaccessible. The service
# then dies with "Failed to initialize cache ... Permission denied" and
# status=2. The .venv is already complete (uv sync --locked --no-dev during
# deploy), so starting the service doesn't need uv at all.
#
# The interpreter is referenced by absolute path because systemd has a minimal
# PATH. This is also the venv python — the shebang in .venv/bin/uvicorn points
# to the same path, so nothing gets resolved twice.
Environment=GAMECOOLER_STATE_DIR=/var/lib/gamecooler
# Paperless upload (docs/paperless.md): PAPERLESS_URL and PAPERLESS_TOKEN.
# The "-" makes the file optional — without it the upload is simply off.
# A file rather than Environment= lines because the token must not live in a
# unit that sits in the repo.
EnvironmentFile=-/etc/gamecooler/paperless.env
ExecStart=/opt/gamecooler/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010

Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/gamecooler

[Install]
WantedBy=multi-user.target

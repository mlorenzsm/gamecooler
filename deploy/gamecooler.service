[Unit]
Description=Gamecooler Webapp
Documentation=file:/opt/gamecooler/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=gamecooler
Group=gamecooler
WorkingDirectory=/opt/gamecooler

# Direkt in die .venv, NICHT über "uv run": uv legt seinen Cache unter
# $HOME/.cache/uv an, und ProtectHome=yes macht $HOME unzugänglich. Der Dienst
# stirbt dann mit "Failed to initialize cache ... Permission denied" und
# status=2. Die .venv ist bereits vollständig (uv sync --locked --no-dev beim
# Deploy), also braucht der Start uv gar nicht.
#
# Der Interpreter ist über den absoluten Pfad angesprochen, weil systemd ein
# minimales PATH hat. Das ist zugleich das venv-python — der Shebang in
# .venv/bin/uvicorn zeigt auf denselben Pfad, es wird also nichts doppelt
# aufgelöst.
Environment=GAMECOOLER_STATE_DIR=/var/lib/gamecooler
ExecStart=/opt/gamecooler/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010

Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/gamecooler

[Install]
WantedBy=multi-user.target

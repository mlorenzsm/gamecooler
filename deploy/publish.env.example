# Upload of the public stock page to the web host. Copy to
# /etc/gamecooler/publish.env (mode 0640, root:gamecooler) and fill in —
# see docs/deploy.md, "Public stock page on wint.global".
#
# The password is a secret: keep the real value in the password manager, never
# in the repo, config.yaml, a ticket or a chat.
#
# Without these settings the app simply doesn't publish: every upload is a
# no-op and the stock changes work exactly as before.

# FTP host of the hosting package (Plesk shows it under "Web Hosting Access").
PUBLISH_HOST=ftp.wildlorenz.de

# Plesk's FTP runs FTPS on the normal port; only change this if the host says so.
PUBLISH_PORT=21

PUBLISH_USER=

# Password of the FTP user. FTPS encrypts it in transit.
PUBLISH_PASSWORD=

# Directory the domain is served from. Plesk uses httpdocs/ — not cPanel's
# public_html/. A leading or trailing slash is ignored.
PUBLISH_PATH=httpdocs

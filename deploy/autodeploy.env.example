# Umgebungskonfiguration für den Autodeploy. Diese Werte gehören NICHT ins
# Repo — sie unterscheiden die Umgebungen voneinander und werden beim
# Bootstrap einmal von Hand gesetzt. Der Deploy fasst sie nie an; genau
# deshalb behält der Test-Container seinen eigenen Namen.
#
# Eine Datei, gelesen vom Deploy-Skript:
#
#   /etc/default/gamecooler-autodeploy
#
# Beide Werte sind Pflicht. Fehlt einer, bricht das Skript mit exit 2 ab,
# statt etwas Falsches auszurollen.

# Welchem Branch folgt dieser Container?
#
#   dev  -> Test-Container
#   main -> Prod
#
# Ein anderer Wert lässt das Skript mit exit 2 abbrechen, damit ein Tippfehler
# nicht stillschweigend etwas anderes deployt.
GAMECOOLER_BRANCH=dev

# Unter welchem Namen ist diese Instanz erreichbar?
#
#   gamecooler-test.home.arpa  (Test)
#   wildbret.home.arpa         (Prod)
#
# Das Skript setzt den Namen beim Deploy in deploy/Caddyfile an Stelle des
# Platzhalters __HOST__ ein und installiert das Ergebnis nach
# /etc/caddy/Caddyfile.
#
# Hier ist bewusst KEIN Default. Vorher las Caddy den Namen aus der Umgebung,
# mit dem Prod-Namen als Rückfall — und weil die Unit des Debian-Pakets gar
# kein EnvironmentFile hat, griff der Rückfall immer. Der Test-Container
# lauschte damit unter wildbret.home.arpa und war unter seinem eigenen Namen
# nicht mehr erreichbar. Ein fehlender Wert muss lauter scheitern als ein
# falscher.
#
# Muss identisch mit dem Pi-hole-Eintrag und der URL im Browser sein.
GAMECOOLER_HOST=gamecooler-test.home.arpa

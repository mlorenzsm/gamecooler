# Environment configuration for autodeploy. These values do NOT belong in the
# repo — they are what distinguishes the environments from each other and are
# set by hand once during bootstrap. The deploy never touches them; that is
# exactly why the test container keeps its own name.
#
# One file, read by the deploy script:
#
#   /etc/default/gamecooler-autodeploy
#
# Both values are required. If one is missing, the script aborts with exit 2
# instead of rolling out something wrong.

# Which branch does this container follow?
#
#   dev  -> test container
#   main -> prod
#
# Any other value makes the script abort with exit 2, so that a typo doesn't
# silently deploy something else.
GAMECOOLER_BRANCH=dev

# Under which name is this instance reachable?
#
#   gamecooler-test.home.arpa  (test)
#   wildbret.home.arpa         (prod)
#
# During deploy, the script substitutes this name for the __HOST__ placeholder
# in deploy/Caddyfile and installs the result to /etc/caddy/Caddyfile.
#
# There is deliberately NO default here. Caddy used to read the name from the
# environment, with the prod name as fallback — and because the Debian
# package's unit has no EnvironmentFile at all, the fallback always kicked in.
# The test container therefore listened as wildbret.home.arpa and was no longer
# reachable under its own name. A missing value must fail more loudly than a
# wrong one.
#
# Must be identical to the Pi-hole entry and the URL in the browser.
GAMECOOLER_HOST=gamecooler-test.home.arpa

[Unit]
Description=Gamecooler Autodeploy check every 5 minutes
Documentation=file:/opt/gamecooler/docs/autodeploy.md

[Timer]
# Two minutes after boot: the first run shouldn't compete with startup, but
# shouldn't wait for the first interval either.
OnBootSec=2min

# Every 5 minutes after that. The run itself is cheap when there's nothing to
# do: a single "git ls-remote" with no object transfer.
OnUnitActiveSec=5min

# Jitter, so that not all containers query GitHub at the same time.
RandomizedDelaySec=30

# Persistent stays off (systemd default): missed runs are not caught up, the
# next regular run does the same job.

[Install]
WantedBy=timers.target
